FROM python:3.12-slim

WORKDIR /app

COPY . .

RUN apt-get update && apt-get install --no-install-recommends -y ncurses-bin && rm -rf /var/lib/apt/lists/*

ENV TERM=xterm-256color

ENV NAME=Player
ENV HOST=host.docker.internal
ENV PORT=54321

# Runs unprivileged. /app stays root-owned and is only ever read, so the game has
# no write access to its own code.
RUN useradd --system --no-create-home --shell /usr/sbin/nologin nullopoly
USER nullopoly

CMD ["sh", "-c", "python client.py --name ${NAME} --host ${HOST} --port ${PORT}"]
